---
const { toc, entry } = Astro.locals.starlightRoute;
const tocTogglePages = ['guides', 'guides/about'];
const canToggleTableOfContents = Boolean(
	toc && (entry.data.presentation || tocTogglePages.includes(entry.id)),
);
---

<div class="two-column-content lg:sl-flex" data-presentation-layout={canToggleTableOfContents ? '' : undefined}>
	{
		toc && (
			<aside id="page-table-of-contents" class="right-sidebar-container print:hidden">
				<div class="right-sidebar">
					<slot name="right-sidebar" />
				</div>
			</aside>
		)
	}
	{
		canToggleTableOfContents && (
			<button class="toc-layout-toggle print:hidden" type="button" aria-controls="page-table-of-contents" aria-expanded="true">
				<span class="collapse-label">목차 접기</span>
				<span class="expand-label">목차 펼치기</span>
			</button>
		)
	}
	<div class="main-pane"><slot /></div>
</div>

<script>
	const layout = document.querySelector<HTMLElement>('[data-presentation-layout]');
	const toggle = layout?.querySelector<HTMLButtonElement>('.toc-layout-toggle');
	const tableOfContents = layout?.querySelector<HTMLElement>('#page-table-of-contents');

	toggle?.addEventListener('click', () => {
		const isCollapsed = layout!.classList.toggle('toc-is-collapsed');
		tableOfContents!.hidden = isCollapsed;
		toggle.setAttribute('aria-expanded', String(!isCollapsed));
	});
</script>

<style>
	@layer starlight.core {
		.main-pane { isolation: isolate; }
		.toc-layout-toggle { display: none; }

		@media (min-width: 72rem) {
			.right-sidebar-container {
				order: 2;
				position: relative;
				width: max(
					var(--sl-sidebar-width),
					calc(var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2)
				);
			}

			.right-sidebar {
				position: fixed;
				top: 0;
				border-inline-start: 1px solid var(--sl-color-hairline);
				padding-top: var(--sl-nav-height);
				width: 100%;
				height: 100vh;
				overflow-y: auto;
				scrollbar-width: none;
			}

			.main-pane { width: 100%; }

			:global([data-has-sidebar][data-has-toc]) .main-pane {
				--sl-content-margin-inline: auto 0;
				order: 1;
				width: min(
					calc(100% - var(--sl-sidebar-width)),
					calc(var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2)
				);
			}

			.toc-layout-toggle {
				display: block;
				position: fixed;
				z-index: calc(var(--sl-z-index-toc) + 1);
				top: calc(var(--sl-nav-height) + 0.6rem);
				right: 1rem;
				border: 1px solid var(--sl-color-gray-5);
				border-radius: 0.35rem;
				padding: 0.35rem 0.5rem;
				background: var(--sl-color-bg-nav);
				color: var(--sl-color-gray-2);
				font-size: var(--sl-text-xs);
				cursor: pointer;
			}

			.toc-layout-toggle:hover { color: var(--sl-color-text-accent); border-color: var(--sl-color-accent); }
			.expand-label { display: none; }
			.toc-is-collapsed .collapse-label { display: none; }
			.toc-is-collapsed .expand-label { display: inline; }
			:global([data-has-sidebar][data-has-toc]) .toc-is-collapsed .main-pane {
				--sl-content-margin-inline: auto;
				--sl-content-width: 67.5rem;
				width: 100%;
			}
		}
	}
</style>
